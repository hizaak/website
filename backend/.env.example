# Backend Environment Variables
# Copy this file to backend/.env and fill in the real values.
# backend/.env is not versioned: it holds the secrets. In production,
# docker-compose.yml mounts it into the container (it is never copied into
# the image); JWT_SECRET, CORS_ORIGIN and ADMIN_PASSWORD then come from the
# root .env instead.

# Application Mode (in production, the MongoDB host is always "mongodb")
NODE_ENV=development

# Server Port
PORT=3000

# JWT Authentication (generate one with: openssl rand -base64 64)
JWT_SECRET=your-super-secret-key-change-in-production

# MongoDB Connection (user created by init-mongo.js)
MONGO_USER=mongodb
MONGO_PASS=mongodb
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=mongodb

# CORS Configuration
CORS_ORIGIN=http://localhost:4200

# Public API URL, used in link previews
PROD_URL=https://api.alexandremaurice.fr

# Public site URL used in the sitemap
SITE_URL=https://alexandremaurice.fr

# Password of the admin account, only used to create it on first start
ADMIN_PASSWORD=
