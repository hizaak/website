# Secrets
.env
.env.*
!.env.example

# Dependencies (package-lock.json files are versioned: the Dockerfiles use npm ci)
node_modules/

# Build outputs and caches
dist/
.angular/
coverage/
*.map

# Uploaded content, kept out of git: only the empty folders are versioned
backend/uploads/**
!backend/uploads/.gitkeep
!backend/uploads/documents/
!backend/uploads/documents/.gitkeep

# Logs
*.log
logs/

# Editors and OS
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp
*~
.DS_Store
Thumbs.db

# Local sample photos, never versioned
sample_photos/
