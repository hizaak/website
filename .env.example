# Read by docker-compose.yml (production). The backend's own settings
# (MongoDB user, URLs...) are in backend/.env, mounted into its container.

NODE_ENV=production
BACKEND_PORT=3000

# Generate one with: openssl rand -base64 64
JWT_SECRET=
# Origin of the site, allowed to call the API.
CORS_ORIGIN=https://alexandremaurice.fr
# Only used to create the admin account on the very first start.
ADMIN_PASSWORD=

# MongoDB root account, created when the database volume is first
# initialized. Required: there is no default. The application's own database
# and user are created by backend/init-mongo.js, and set in backend/.env.
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=

ANGULAR_ENV=production
